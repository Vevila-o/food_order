# 複製成 .env 後填值（.env 已列入 .gitignore，絕不 commit）。
# 正式環境改設在主機的環境變數。

# 全站 HTTP Basic Auth（正式環境缺少時一律 401）
ACCESS_USER=
ACCESS_PASSWORD=

# 單機部署時讓 Puma 內嵌 Solid Queue
SOLID_QUEUE_IN_PUMA=true

# M3：KKTIX Webhook 驗證（openssl rand -hex 32 產生）
KKTIX_WEBHOOK_SECRET=

# M3：Ruby Taiwan GitHub Project 唯讀 token（fine-grained）
GITHUB_TOKEN=

# M4：OpenAI（專案專用 key，設每月花費上限）
OPENAI_API_KEY=

# M5：Google Places（限定 Places API 與伺服器 IP）
GOOGLE_PLACES_API_KEY=
