<header class="border-b border-base-300 bg-base-100">
  <div class="page-container flex flex-col gap-3 pt-3 pb-4 md:pt-5">
    <%= back_link if back_link? %>
    <%= content_tag(@nav_label ? :nav : :div, class: "flex items-start gap-1", "aria-label": @nav_label) do %>
      <%# 手機的選單按鈕（開側欄抽屜，由 layout 的 dialog controller 處理）；桌機側欄一直在，不需要 %>
      <button type="button" class="tap-target -ml-3 inline-flex size-11 shrink-0 items-center justify-center rounded-full md:hidden" aria-label="開啟選單" data-action="dialog#open">
        <%= render IconComponent.new(name: :menu, size: 22) %>
      </button>
      <div class="flex min-w-0 flex-1 items-start justify-between gap-3">
        <div class="flex min-w-0 flex-col gap-0.5 md:pt-0 pt-0.5">
          <% if @eyebrow %><span class="text-[13px] font-medium text-muted"><%= @eyebrow %></span><% end %>
          <h1 class="text-2xl font-bold tracking-wide md:text-[26px]"><%= @title %></h1>
          <% if @subtitle %><span class="text-[13px] text-muted"><%= @subtitle %></span><% end %>
        </div>
        <% if actions? %><div class="flex shrink-0 items-center gap-2"><%= actions %></div><% end %>
      </div>
    <% end %>
    <%= summary if summary? %>
  </div>
</header>
