<header class="border-b border-base-300 bg-base-100">
  <div class="page-container flex flex-col gap-3 pt-3 pb-4 md:pt-5">
    <%= back_link if back_link? %>
    <div class="flex items-start justify-between gap-3">
      <div class="flex min-w-0 flex-col gap-0.5">
        <% if @eyebrow %><span class="text-[13px] font-medium text-muted"><%= @eyebrow %></span><% end %>
        <h1 class="text-2xl font-bold tracking-wide md:text-[26px]"><%= @title %></h1>
        <% if @subtitle %><span class="text-[13px] text-muted"><%= @subtitle %></span><% end %>
      </div>
      <% if actions? %><div class="flex shrink-0 items-center gap-2"><%= actions %></div><% end %>
    </div>
    <%= summary if summary? %>
  </div>
</header>
