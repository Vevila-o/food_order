<div class="md:overflow-x-auto md:rounded-2xl md:bg-base-100 md:p-2 md:shadow-sm">
  <table class="w-full text-left text-sm">
    <caption class="sr-only"><%= caption %></caption>
    <thead class="hidden md:table-header-group">
      <tr class="text-xs text-muted">
        <% headers.each do |header| %>
          <th scope="col" class="whitespace-nowrap px-3 py-2 font-medium"><%= header %></th>
        <% end %>
      </tr>
    </thead>
    <tbody class="block md:table-row-group">
      <% rows.each do |cells| %>
        <tr class="mb-3 block rounded-2xl bg-base-100 p-4 shadow-sm md:mb-0 md:table-row md:rounded-none md:bg-transparent md:p-0 md:shadow-none md:border-t md:border-base-300">
          <% cells.each_with_index do |cell, index| %>
            <td class="<%= cell_class(index) %>">
              <span class="text-xs text-muted md:hidden"><%= headers[index] %></span>
              <span><%= cell %></span>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
