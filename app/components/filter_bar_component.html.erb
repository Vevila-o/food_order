<div data-controller="dialog" data-action="turbo:submit-end->dialog#close">
  <%= tag.form id: form_id, action: clear_path, method: "get", data: { controller: "auto-submit", action: "change->auto-submit#submit", turbo_frame: "merchant-list", turbo_action: "advance" } do %>
    <div class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1 md:mx-0 md:flex-wrap md:overflow-visible md:px-0" role="group" aria-label="快速篩選">
      <% CHIPS.each do |name, value, label| %>
        <%# relative：隱藏的 checkbox（sr-only 是絕對定位）要以 label 為基準，才會被橫向捲動區裁切，不會撐寬整個頁面 %>
        <label class="relative shrink-0" for="<%= input_id(name, value) %>">
          <input type="checkbox" class="peer sr-only" id="<%= input_id(name, value) %>" name="<%= input_name(name) %>" value="<%= value %>" <%= "checked" if checked?(name, value) %>>
          <span class="inline-flex min-h-11 cursor-pointer items-center whitespace-nowrap rounded-full border border-soft bg-base-100 px-4 text-[13px] font-medium peer-checked:border-primary peer-checked:bg-primary peer-checked:font-bold peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-base-content md:min-h-10 md:text-sm"><%= label %></span>
        </label>
      <% end %>
      <button type="button" data-action="dialog#open" class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap rounded-full border border-dashed border-soft px-4 text-[13px] font-medium md:min-h-10 md:text-sm">
        更多篩選<%= " (#{drawer_active_count})" if drawer_active_count.positive? %>
      </button>
    </div>
  <% end %>

  <dialog class="modal modal-bottom md:modal-middle" data-dialog-target="dialog" aria-label="更多篩選">
    <div class="modal-box max-h-[85dvh] pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
      <h2 class="mb-4 text-lg font-bold">更多篩選與排序</h2>
      <div class="space-y-5">
        <fieldset>
          <legend class="mb-1 font-bold">更多條件</legend>
          <% DRAWER_CHECKS.each do |name, value, label| %>
            <label class="tap-target flex items-center gap-2" for="drawer-<%= input_id(name, value) %>">
              <input type="checkbox" class="checkbox checkbox-sm" form="<%= form_id %>" id="drawer-<%= input_id(name, value) %>"
                     name="<%= input_name(name) %>" value="<%= value %>" <%= "checked" if checked?(name, value) %>>
              <%= label %>
            </label>
          <% end %>
        </fieldset>
        <div>
          <label class="mb-1 block font-bold" for="drawer-sort">排序</label>
          <select class="select w-full" form="<%= form_id %>" name="filter[sort]" id="drawer-sort">
            <% SORT_LABELS.each do |value, label| %>
              <option value="<%= value %>" <%= "selected" if filter.sort == value %>><%= label %></option>
            <% end %>
          </select>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button type="submit" form="<%= form_id %>" class="btn btn-primary">套用</button>
          <% if filter.active? %>
            <%= link_to "清除全部篩選", clear_path, class: "btn btn-ghost", data: { turbo_frame: "merchant-list", turbo_action: "advance" } %>
          <% end %>
          <button type="button" class="btn btn-ghost" data-action="dialog#close">關閉</button>
        </div>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button aria-label="關閉篩選">關閉</button></form>
  </dialog>
</div>
