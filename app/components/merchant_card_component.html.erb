<article class="group/card flex flex-col gap-2.5 rounded-2xl bg-base-100 p-4 shadow-sm" id="<%= helpers.dom_id(merchant) %>">
  <div class="flex items-start justify-between gap-2">
    <div class="flex min-w-0 flex-col gap-0.5">
      <h2 class="text-[17px] font-bold leading-snug">
        <%# 卡片在 Turbo Frame（merchant-list）裡，連結要跳出 frame；在同一個分頁換網址，不開新分頁 %>
        <%= link_to merchant.name, helpers.merchant_path(merchant), class: "tap-target inline-flex items-center hover:underline",
              data: { turbo_frame: "_top" } %>
      </h2>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
        <% if area_text %><span><%= area_text %></span><% end %>
        <%= render OrderedDotComponent.new(ordered: merchant.ordered_before?) %>
        <% if recent_order_text %><%= render(PillComponent.new(tone: :secondary)) { recent_order_text } %><% end %>
      </p>
    </div>
    <div class="flex shrink-0 gap-1">
      <%= render ToggleButtonComponent.new(merchant: merchant, kind: :favorite) %>
      <%= render ToggleButtonComponent.new(merchant: merchant, kind: :shortlist) %>
    </div>
  </div>

  <div class="flex flex-wrap gap-1.5">
    <%= render KindBadgeComponent.new(kind: merchant.kind) %>
    <%= render PriceEstimateComponent.new(merchant: merchant) %>
    <%= render(PillComponent.new(tone: :base)) { menu_date_text } %>
    <% if show_freshness? %>
      <%= render FreshnessBadgeComponent.new(freshness: merchant.menu_freshness) %>
    <% end %>
  </div>

  <dl class="grid grid-cols-2 gap-2 text-[13px]">
    <div class="flex flex-col gap-0.5">
      <dt class="text-xs text-muted">19:00 外送</dt>
      <dd>
        <% if delivers_at_19_known? %>
          <span class="text-sm font-bold"><%= delivers_at_19_text %></span>
        <% else %>
          <%= render(PillComponent.new(tone: :secondary)) { delivers_at_19_text } %>
        <% end %>
      </dd>
    </div>
    <div class="flex flex-col gap-0.5">
      <dt class="text-xs text-muted">外送費</dt>
      <dd>
        <% if delivery_fee_known? %>
          <span class="text-sm font-bold"><%= delivery_fee_text %></span>
        <% else %>
          <%= render(PillComponent.new(tone: :secondary)) { delivery_fee_text } %>
        <% end %>
      </dd>
    </div>
  </dl>

  <%# 左下角的灰色「查看」。滑鼠移到整張卡片（或鍵盤聚焦連結）時，箭頭沿 cubic-bezier 曲線向右滑，
      滑出容器右緣（overflow-x-clip 裁掉）而消失；100cqw = 這個 @container 的寬度，所以距離會跟著卡片寬度走 %>
  <div class="@container mt-auto overflow-x-clip">
    <%= link_to helpers.merchant_path(merchant), data: { turbo_frame: "_top" },
          aria: { label: "查看#{merchant.name}的菜單與建議搭配" },
          class: "tap-target inline-flex items-center gap-1.5 text-sm font-medium text-muted" do %>
      查看
      <span class="inline-flex transition-transform duration-700 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/card:translate-x-[100cqw] group-focus-within/card:translate-x-[100cqw] motion-reduce:transition-none motion-reduce:transform-none">
        <%= render IconComponent.new(name: :arrow_right, size: 16) %>
      </span>
    <% end %>
  </div>
</article>
