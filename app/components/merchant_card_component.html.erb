<article class="rounded-box bg-base-200 p-4" id="<%= helpers.dom_id(merchant) %>">
  <div class="flex items-start justify-between gap-2">
    <h2 class="text-lg font-bold leading-snug">
      <%# 卡片在 Turbo Frame（merchant-list）裡，連結要跳出 frame；桌機開新分頁由 detail-link 處理 %>
      <%= link_to merchant.name, helpers.merchant_path(merchant), class: "tap-target inline-flex items-center underline-offset-2 hover:underline",
            data: { turbo_frame: "_top", controller: "detail-link" } %>
      <% if distance_text %>
        <span class="text-sm font-normal opacity-80">· <%= distance_text %></span>
      <% end %>
    </h2>
    <%= render OrderedDotComponent.new(ordered: merchant.ordered_before?) %>
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-2">
    <%= render KindBadgeComponent.new(kind: merchant.kind) %>
    <%= render PriceEstimateComponent.new(merchant: merchant) %>
  </div>

  <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
    <dt class="opacity-80">19:00 外送</dt>
    <dd><%= delivers_at_19_text %></dd>
    <dt class="opacity-80">外送費</dt>
    <dd><%= delivery_fee_text %></dd>
    <dt class="opacity-80">菜單日期</dt>
    <dd class="flex flex-wrap items-center gap-2">
      <%= menu_date_text %>
      <%= render FreshnessBadgeComponent.new(freshness: merchant.menu_freshness) %>
    </dd>
  </dl>

  <% if actions? %>
    <div class="mt-3 flex flex-wrap gap-2"><%= actions %></div>
  <% end %>
</article>
