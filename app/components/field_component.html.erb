<div class="mb-4">
  <%= @form.label @attribute, label_content, class: "mb-1 block font-medium" %>
  <%= content %>
  <% if @hint %>
    <p class="mt-1 text-sm opacity-80"><%= @hint %></p>
  <% end %>
  <% errors.each do |message| %>
    <p class="mt-1 border-l-4 border-warning pl-2 text-sm font-medium" role="alert"><%= message %></p>
  <% end %>
</div>
