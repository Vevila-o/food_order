<section class="flex flex-col gap-3 rounded-2xl bg-base-100 p-4" aria-label="金額與預算">
  <dl class="grid grid-cols-[1fr_auto] gap-x-3 gap-y-1.5 text-sm">
    <dt class="text-muted">小計</dt>
    <dd class="text-right font-medium tabular-nums"><%= subtotal_text %></dd>
    <dt class="text-muted">外送費</dt>
    <dd class="text-right font-medium tabular-nums"><%= fee_text %></dd>
    <dt class="font-bold">預計金額</dt>
    <dd class="text-right text-lg font-bold tabular-nums"><%= total_text %></dd>
  </dl>

  <div class="flex flex-col gap-2 rounded-xl bg-base-200 p-3">
    <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
      <span class="text-muted">本場總預算（<%= budget.headcount %> 人 × NT$<%= Event::PER_PERSON_BUDGET %>）</span>
      <span class="font-bold tabular-nums"><%= total_budget_text %></span>
    </div>
    <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
      <span class="text-muted">本場合計<%= "（含其他店家）" if others.any? %></span>
      <span class="font-bold tabular-nums"><%= event_total_text %></span>
    </div>
    <% if others.any? %>
      <ul class="text-xs text-muted">
        <% others.each do |inquiry| %>
          <li class="flex justify-between gap-2">
            <span class="truncate"><%= inquiry.merchant.name %></span>
            <span class="tabular-nums"><%= inquiry.total ? helpers.format_money(inquiry.total) : "外送費待確認" %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% tone, text = status %>
    <div><%= render(PillComponent.new(tone: tone)) { text } %></div>
  </div>
</section>
