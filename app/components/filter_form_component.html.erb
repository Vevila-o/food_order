<%= tag.form action: clear_path, method: "get", class: "space-y-5", data: form_data do %>
  <fieldset>
    <legend class="mb-1 font-bold">店家類型</legend>
    <% kind_options.each do |label, value| %>
      <label class="tap-target flex items-center gap-2" for="<%= dom_id_for("kind-#{value.presence || 'all'}") %>">
        <input type="radio" class="radio radio-sm" name="filter[kind]" value="<%= value %>"
               id="<%= dom_id_for("kind-#{value.presence || 'all'}") %>" <%= "checked" if filter.kind.to_s == value %>>
        <%= label %>
      </label>
    <% end %>
  </fieldset>

  <fieldset>
    <legend class="mb-1 font-bold">條件</legend>
    <% FLAG_LABELS.each do |flag, label| %>
      <label class="tap-target flex items-center gap-2" for="<%= dom_id_for(flag) %>">
        <input type="checkbox" class="checkbox checkbox-sm" name="filter[<%= flag %>]" value="1"
               id="<%= dom_id_for(flag) %>" <%= "checked" if filter.flag?(flag) %>>
        <%= label %>
      </label>
    <% end %>
  </fieldset>

  <div>
    <label class="mb-1 block font-bold" for="<%= dom_id_for("sort") %>">排序</label>
    <select class="select w-full" name="filter[sort]" id="<%= dom_id_for("sort") %>">
      <% SORT_LABELS.each do |value, label| %>
        <option value="<%= value %>" <%= "selected" if filter.sort == value %>><%= label %></option>
      <% end %>
    </select>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <% if drawer? %>
      <button type="submit" class="btn btn-primary">套用</button>
    <% else %>
      <noscript><button type="submit" class="btn btn-primary">套用</button></noscript>
    <% end %>
    <% if filter.active? %>
      <%= link_to "清除篩選", clear_path, class: "btn btn-ghost", data: { turbo_frame: "merchant-list", turbo_action: "advance" } %>
    <% end %>
  </div>
<% end %>
