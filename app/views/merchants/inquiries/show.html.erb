<% content_for :title, "訂單詢問 · #{@merchant.name} · Ruby Jam 訂餐助手" %>
<% two = @pair.two_merchants? %>
<% partner_form = @pair.partner %>
<% role_label = { food: "選餐食", drink: "選飲料", any: "加選另一家" }.fetch(@pair.partner_role) %>
<% content_for :header do %>
  <%= render(PageHeaderComponent.new(title: "訂單詢問", subtitle: two ? "#{@merchant.name} ＋ #{partner_form.merchant.name}" : @merchant.name)) do |header| %>
    <% header.with_back_link { render BackLinkComponent.new(label: "返回店家", href: merchant_path(@merchant)) } %>
    <% header.with_summary do %>
      <div class="flex flex-wrap items-center gap-1.5">
        <%= render(PillComponent.new(tone: :soft)) { "#{@event.held_on.month}/#{@event.held_on.day}（#{@event.weekday_label.delete_prefix('週')}）#{@event.delivery_window_label} 送達" } %>
        <%= render(PillComponent.new(tone: :base)) { "#{@event.headcount} 人" } %>
        <%= render(PillComponent.new(tone: :base)) { "總預算 #{format_money(@event.total_budget)}" } %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# inquiry：複製 / 標記 / 挑選搭檔；dialog：右側的「選另一家」面板 %>
<div class="flex max-w-2xl flex-col gap-3.5" data-controller="inquiry dialog"
     data-inquiry-save-url-value="<%= merchant_inquiry_path(@merchant) %>"
     data-inquiry-partner-url-value="<%= partner_merchant_inquiry_path(@merchant) %>"
     data-action="turbo:frame-load->inquiry#ready">
  <% if @pair.event_passed? %>
    <div data-controller="dismissible">
      <%= render(AlertComponent.new(type: :alert)) do %>
        <span class="flex flex-col gap-2">
          <span>活動日期 <%= @event.held_on.strftime("%Y/%-m/%-d") %> 已過，要設定下一場嗎？</span>
          <span class="flex flex-wrap gap-2">
            <%= link_to "設定下一場", edit_event_path(@event), class: "btn btn-sm btn-primary" %>
            <button type="button" class="btn btn-sm btn-ghost" data-action="dismissible#dismiss">先用這場繼續</button>
          </span>
        </span>
      <% end %>
    </div>
  <% end %>

  <%# 數量表單：GET，改動就自動送出，結果更新在下方的 Turbo Frame（網址保留數量與搭檔，可重新整理） %>
  <%= form_with url: merchant_inquiry_path(@merchant), method: :get, class: "flex flex-col gap-3.5",
        data: { controller: "auto-submit", inquiry_target: "form", turbo_frame: "inquiry-result", turbo_action: "replace",
                action: "input->inquiry#markPending input->auto-submit#submit" } do %>
    <%# 空字串 = 明確沒有搭檔（之後的自動更新不會又帶出已存的組） %>
    <%= hidden_field_tag :partner_id, partner_form&.merchant&.id.to_s, id: nil %>

    <section class="rounded-2xl bg-base-100 p-4" aria-label="<%= @merchant.name %>的餐點">
      <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-base font-bold"><%= two ? "#{@merchant.name}的餐點" : "選餐點" %></h2>
        <% unless two %>
          <button type="button" class="btn btn-sm btn-outline" data-action="dialog#open"><%= role_label %></button>
        <% end %>
      </div>
      <p class="mb-2 text-sm text-muted">只列出菜單在 4 個月內的項目。數量可以用 −／＋，或按「＝ 人數」一次設成 <%= @event.headcount %>。</p>
      <%= render "items", form: @pair.main, headcount: @event.headcount %>
    </section>

    <% if two %>
      <section class="rounded-2xl bg-base-100 p-4 ring-1 ring-soft" aria-label="<%= partner_form.merchant.name %>的餐點">
        <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-base font-bold"><%= partner_form.merchant.name %>的餐點</h2>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-outline" data-action="dialog#open">換一家</button>
            <button type="button" class="btn btn-sm btn-ghost" data-action="inquiry#resetPartner">重置，只算這家</button>
          </div>
        </div>
        <p class="mb-2 text-sm text-muted">配對的另一家，兩家的金額與外送費會一起計算。</p>
        <%= render "items", form: partner_form, headcount: @event.headcount %>
      </section>
    <% end %>
  <% end %>

  <%# 右側面板（像選機票）：開啟後才載入候選店家清單 %>
  <dialog class="modal modal-end" data-dialog-target="dialog" aria-label="選擇搭配的店家">
    <div class="modal-box h-full max-h-none w-[min(100vw,28rem)] max-w-none rounded-none bg-base-200 pt-[calc(1rem+env(safe-area-inset-top))]">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-lg font-bold"><%= { food: "選擇餐食店家", drink: "選擇飲料店家", any: "選擇另一家" }.fetch(@pair.partner_role) %></h2>
        <button type="button" class="tap-target -mr-2 inline-flex size-11 items-center justify-center rounded-full" aria-label="關閉" data-action="dialog#close">
          <%= render IconComponent.new(name: :close, size: 22) %>
        </button>
      </div>
      <%= turbo_frame_tag "partner-list", src: partners_merchant_inquiry_path(@merchant, role: @pair.partner_role, partner_id: partner_form&.merchant&.id.to_s), loading: :lazy do %>
        <p class="text-sm text-muted">載入中…</p>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop"><button aria-label="關閉">關閉</button></form>
  </dialog>

  <%= turbo_frame_tag "inquiry-result", class: "flex flex-col gap-3.5" do %>
    <% if @pair.visible_errors.any? %>
      <%= render AlertComponent.new(type: :alert) do %>
        <ul class="list-disc pl-5">
          <% @pair.visible_errors.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <% parts = @pair.selected_forms.size > 1 ? @pair.selected_forms.map { |form| BudgetSummaryComponent::Part.new(name: form.merchant.name, pricing: form.pricing) } : [] %>
    <%= render BudgetSummaryComponent.new(pricing: @pair.combined, budget: @pair.budget, any_lines: @pair.any_lines?, parts: parts) %>

    <% @pair.forms.each do |form| %>
      <% sendable = @pair.errors.empty? && form.any_lines? %>
      <% message_id = "inquiry-message-#{form.merchant.id}" %>
      <% suffix = two ? " · #{form.merchant.name}" : "" %>
      <% if sendable %>
        <%= render MessagePreviewComponent.new(text: form.message, dom_id: message_id, title: "詢問訊息#{suffix}", merchant_id: form.merchant.id, edited: form.message_edited?,
              notice: (@pair.event_passed? ? "活動日期 #{@event.held_on.strftime('%-m/%-d')} 已過，請確認日期再送出" : nil)) %>
      <% else %>
        <section class="rounded-2xl bg-base-100 p-4">
          <h2 class="mb-1 text-base font-bold">詢問訊息<%= suffix %></h2>
          <p class="text-sm text-muted">選好餐點後會在這裡產生訊息。</p>
          <span id="<%= message_id %>" hidden></span>
        </section>
      <% end %>
      <%= render ContactButtonsComponent.new(links: form.merchant.contact_links, source_urls: form.merchant.sources.map(&:url).compact_blank,
            disabled: !sendable, message_id: message_id, merchant_id: form.merchant.id, title: "聯絡店家#{suffix}") %>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center gap-2 pb-6">
    <button type="button" class="btn btn-ghost" data-action="inquiry#saveDraft">儲存草稿</button>
    <%= link_to "返回店家", merchant_path(@merchant), class: "btn btn-ghost" %>
    <span class="text-sm font-medium" role="status" aria-live="polite" data-inquiry-target="draftStatus"></span>
  </div>
</div>
