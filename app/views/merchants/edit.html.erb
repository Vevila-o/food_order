<% content_for :title, "編輯 #{@merchant.name} · Ruby Jam 訂餐助手" %>
<% content_for :header do %>
  <%= render(PageHeaderComponent.new(title: "編輯店家", subtitle: @merchant.name)) do |header| %>
    <% header.with_back_link { render BackLinkComponent.new(label: @merchant.name, href: merchant_path(@merchant)) } %>
  <% end %>
<% end %>

<%= render "form", merchant: @merchant %>
