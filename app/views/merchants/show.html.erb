<% content_for :title, "#{@merchant.name} · Ruby Jam 訂餐助手" %>

<div class="max-w-2xl space-y-6">
  <header>
    <div class="flex items-start justify-between gap-3">
      <h1 class="text-2xl font-bold"><%= @merchant.name %></h1>
      <%= render OrderedDotComponent.new(ordered: @merchant.ordered_before?) %>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <%= render KindBadgeComponent.new(kind: @merchant.kind) %>
      <%= render PriceEstimateComponent.new(merchant: @merchant) %>
    </div>
  </header>

  <section class="rounded-box bg-base-200 p-4">
    <h2 class="mb-2 text-lg font-bold">外送資訊</h2>
    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
      <dt class="opacity-80">地址</dt>
      <dd><%= @merchant.address.presence || t("common.not_filled") %><%= "（#{@merchant.district}）" if @merchant.district.present? %></dd>
      <dt class="opacity-80">19:00 外送</dt>
      <dd><%= enum_text(@merchant, :delivers_at_19) %></dd>
      <dt class="opacity-80">可送大安區</dt>
      <dd><%= enum_text(@merchant, :delivers_to_daan) %></dd>
      <dt class="opacity-80">外送費</dt>
      <dd><%= delivery_fee_text(@merchant) %></dd>
      <dt class="opacity-80">最後驗證</dt>
      <dd><%= format_date(@merchant.last_verified_at, fallback: "尚未驗證") %></dd>
    </dl>
    <p class="mt-3 text-sm opacity-80">19:00 能否外送與外送費多半沒有公開資料，會在詢問訊息中一併向店家確認。</p>
  </section>

  <section class="rounded-box bg-base-200 p-4">
    <h2 class="mb-2 text-lg font-bold">聯絡方式</h2>
    <% if @merchant.contact_links.any? %>
      <div class="flex flex-wrap gap-2">
        <% @merchant.contact_links.each do |channel, url| %>
          <%= link_to channel_label(channel), url, class: "btn btn-sm", rel: "noopener noreferrer" %>
        <% end %>
      </div>
    <% else %>
      <p>尚無聯絡方式，請到來源網址查看。</p>
    <% end %>
    <% if @merchant.threads.present? %>
      <p class="mt-3 text-sm">Threads：<%= @merchant.threads %>（沒有私訊連結，僅供參考）</p>
    <% end %>
  </section>

  <section class="rounded-box bg-base-200 p-4">
    <h2 class="mb-2 text-lg font-bold">來源網址</h2>
    <% if @merchant.sources.any? %>
      <ul class="space-y-1 break-all">
        <% @merchant.sources.each do |source| %>
          <li>
            <%= enum_text(source, :platform) %>：
            <%= link_to source.url, source.url, class: "underline", target: "_blank", rel: "noopener noreferrer" if source.url.present? %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="opacity-80">尚未填寫來源網址。</p>
    <% end %>
  </section>

  <section class="rounded-box bg-base-200 p-4">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-lg font-bold">菜單</h2>
      <%= link_to "貼上菜單", new_merchant_menu_import_path(@merchant), class: "btn btn-sm btn-secondary" %>
      <% if @merchant.menu_items.any? %>
        <%= button_to "確認菜單仍有效", verify_menu_merchant_path(@merchant), method: :post, class: "btn btn-sm btn-primary",
              form: { data: { turbo_confirm: "確認這間店的菜單與價格目前仍然有效？所有項目的菜單日期會改為今天。" } } %>
      <% end %>
    </div>
    <% if @merchant.menu_items.any? %>
      <ul class="divide-y divide-base-300">
        <% @merchant.menu_items.sort_by(&:id).each do |item| %>
          <li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 py-2">
            <div>
              <span class="font-medium"><%= item.name %></span>
              <span class="text-sm opacity-80">（<%= enum_text(item, :category) %>）</span>
              <% if item.servings %>
                <div class="text-sm opacity-80">可供 <%= item.servings %> 人，約每人 <%= format_money(item.price_per_serving) %></div>
              <% end %>
            </div>
            <div class="text-right">
              <div><%= format_money(item.price) %><%= " / #{item.unit}" if item.unit.present? %></div>
              <div class="flex items-center justify-end gap-2 text-sm">
                <span class="opacity-80"><%= format_date(item.menu_date, fallback: "日期不明") %></span>
                <%= render FreshnessBadgeComponent.new(freshness: item.freshness) %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="opacity-80">還沒有菜單項目。</p>
    <% end %>
  </section>

  <section class="rounded-box bg-base-200 p-4">
    <h2 class="mb-2 text-lg font-bold">建議搭配</h2>
    <p class="opacity-80">之後會依人數與每人 NT$100 預算建議餐點搭配（M4）。</p>
  </section>

  <div class="flex flex-wrap gap-3">
    <%= link_to "編輯", edit_merchant_path(@merchant), class: "btn btn-primary" %>
    <%= link_to "返回列表", merchants_path, class: "btn btn-ghost" %>
    <%= button_to "刪除", merchant_path(@merchant), method: :delete, class: "btn btn-ghost",
          form: { data: { turbo_confirm: "確定要刪除「#{@merchant.name}」嗎？" } } %>
  </div>
</div>
