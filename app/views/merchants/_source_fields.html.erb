<div class="rounded-box bg-base-200 p-3" data-nested-form-row>
  <%= f.hidden_field :_destroy if f.object.persisted? %>
  <%= f.hidden_field :platform, value: f.object.platform.presence || "manual" %>
  <%= f.label :url, class: "mb-1 block text-sm font-medium" %>
  <%= f.url_field :url, class: "input w-full", placeholder: "https://", autocomplete: "off" %>
  <% if f.object.errors[:url].any? %>
    <p class="mt-1 border-l-4 border-warning pl-2 text-sm font-medium" role="alert"><%= f.object.errors[:url].to_sentence %></p>
  <% end %>
  <button type="button" class="btn btn-ghost btn-sm mt-2" data-action="nested-form#remove">移除這一列</button>
</div>
