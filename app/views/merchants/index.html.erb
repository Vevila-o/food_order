<% content_for :title, "店家 · Ruby Jam 訂餐助手" %>
<% content_for :header do %>
  <%= render(PageHeaderComponent.new(title: "找今晚的餐", eyebrow: "Ruby Jam 訂餐助手")) do |header| %>
    <% header.with_actions do %>
      <%= render IconLinkComponent.new(icon: :settings, label: "設定", href: edit_setting_path, variant: :plain) %>
      <%= render IconLinkComponent.new(icon: :plus, label: "新增店家", href: new_merchant_path) %>
    <% end %>
    <% header.with_summary { render EventSummaryComponent.new(event: @event, edit_href: edit_event_path(@event)) } if @event %>
  <% end %>
<% end %>

<div class="flex flex-col gap-3">
  <% unless @event %>
    <%= render(AlertComponent.new(type: :info)) do %>
      還沒有活動，無法計算預算。<%= link_to "新增活動", new_event_path, class: "font-medium underline" %>
    <% end %>
  <% end %>
  <%= render FilterBarComponent.new(filter: @filter) %>

  <%= turbo_frame_tag "merchant-list", data: { turbo_action: "advance" } do %>
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-base font-bold" aria-live="polite">
        <%= @filter.active? ? "符合條件 " : "共 " %><span class="tabular-nums"><%= @merchants.size %></span> 家
      </h2>
      <% if @filter.active? %>
        <%= link_to "清除篩選", merchants_path, class: "tap-target inline-flex items-center text-sm font-medium", data: { turbo_frame: "merchant-list", turbo_action: "advance" } %>
      <% end %>
    </div>

    <% if @merchants.any? %>
      <div class="grid gap-3 md:grid-cols-[repeat(auto-fill,minmax(280px,1fr))] md:gap-4">
        <% @merchants.each do |merchant| %>
          <%= render MerchantCardComponent.new(merchant: merchant) %>
        <% end %>
      </div>
    <% elsif @total_count.zero? %>
      <%= render(EmptyStateComponent.new(title: "還沒有店家")) do |empty| %>
        <% empty.with_action { link_to "新增店家", new_merchant_path, class: "btn btn-primary" } %>
        可以先新增一間，或到 <%= link_to "/tasks", "/tasks", class: "underline" %> 建立範例資料。
      <% end %>
    <% else %>
      <%= render(EmptyStateComponent.new(title: "沒有符合條件的店家")) do |empty| %>
        <% empty.with_action { link_to "清除篩選", merchants_path, class: "btn btn-primary", data: { turbo_frame: "merchant-list", turbo_action: "advance" } } %>
        試著放寬條件。「19:00 外送」與「每人估價」沒填的店會照常顯示，「免外送費」則只算外送費明確為 0 的店。
      <% end %>
    <% end %>
  <% end %>
</div>
