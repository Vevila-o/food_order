<% content_for :title, "已詢問 · Ruby Jam 訂餐助手" %>
<% content_for :header do %>
  <%= render PageHeaderComponent.new(title: "已詢問", subtitle: "歷史詢問單，共 #{@inquiries.size} 筆") %>
<% end %>

<% if @inquiries.any? %>
  <% status_tones = { "draft" => :base, "sent" => :soft, "confirmed" => :primary } %>
  <% rows = @inquiries.map do |inquiry| %>
    <% [
      format_month(inquiry.event.held_on),
      link_to(inquiry.merchant.name, merchant_path(inquiry.merchant), class: "whitespace-normal underline-offset-2 hover:underline"),
      (partner = inquiry.order_group&.order_inquiries&.find { |other| other.id != inquiry.id }) ? "與 #{partner.merchant.name} 一組" : "—",
      render(PillComponent.new(tone: status_tones.fetch(inquiry.status))) { enum_text(inquiry, :status) },
      enum_text(inquiry, :contacted_via) || "—",
      "#{inquiry.headcount_at_creation} 人",
      inquiry.total ? format_money(inquiry.total) : render(PillComponent.new(tone: :secondary)) { t("common.unknown_amount") },
      l(inquiry.created_at.to_date, format: :long),
      # 訂購：按下去記錄「這家有訂購」，之後店家卡片的圓點變橘色、出現在「已訂購」
      if inquiry.confirmed?
        safe_join([
          render(PillComponent.new(tone: :primary)) { "已訂購" },
          button_to("取消訂購", inquiry_confirmation_path(inquiry), method: :delete, class: "btn btn-xs btn-ghost",
                    form: { class: "inline", data: { turbo_confirm: "取消「#{inquiry.merchant.name}」的訂購紀錄？「已訂購」裡自動產生的那筆也會一併移除。" } })
        ], " ")
      else
        button_to("訂購", inquiry_confirmation_path(inquiry), method: :post, class: "btn btn-sm btn-primary",
                  form: { class: "inline", data: { turbo_confirm: "記錄「#{inquiry.merchant.name}」已訂購？" } })
      end,
      # 只有目前這一場能重開產生器（帶著搭檔）；歷史活動的詢問單只供查看
      inquiry.event_id == @current_event&.id ? link_to("開啟詢問", merchant_inquiry_path(inquiry.merchant, partner_id: partner&.merchant_id.to_s), class: "font-medium underline") : "—"
    ] %>
  <% end %>
  <%= render DataTableComponent.new(headers: %w[活動 店家 搭配 狀態 管道 人數 預計金額 建立日期 訂購 操作], rows: rows, caption: "已詢問的紀錄") %>
<% else %>
  <%= render(EmptyStateComponent.new(title: "還沒有詢問紀錄")) do |empty| %>
    <% empty.with_action { link_to "去看看店家", merchants_path, class: "btn btn-primary" } %>
    在店家頁產生詢問訊息後，就會記錄在這裡。
  <% end %>
<% end %>
