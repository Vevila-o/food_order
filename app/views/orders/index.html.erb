<% content_for :title, "已訂購 · Ruby Jam 訂餐助手" %>
<% content_for :header do %>
  <%= render(PageHeaderComponent.new(title: "已訂購", subtitle: "歷史訂購紀錄，共 #{@order_records.size} 筆", breadcrumb: [ [ "已訂購" ] ])) do |header| %>
    <% header.with_actions { render IconLinkComponent.new(icon: :plus, label: "補登訂購", href: new_order_path) } %>
  <% end %>
<% end %>

<% if @order_records.any? %>
  <% rows = @order_records.map do |record| %>
    <% [
      record.ordered_on ? l(record.ordered_on, format: :long) : "日期不明",
      link_to(record.merchant.name, merchant_path(record.merchant), class: "underline-offset-2 hover:underline"),
      record.headcount ? "#{record.headcount} 人" : "—",
      record.total ? format_money(record.total) : "—",
      enum_text(record, :source),
      record.note.presence || "—",
      # 只有手動補登的能刪除（詢問單確認訂購產生的，要到「已詢問」按叉叉取消）
      (button_to(order_path(record), method: :delete, title: "刪除補登紀錄", aria: { label: "刪除補登紀錄：#{record.merchant.name}" },
                 class: "inline-flex size-11 cursor-pointer items-center justify-center rounded-full bg-base-200 hover:bg-warning-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content",
                 form: { class: "contents", data: { turbo_confirm: "刪除「#{record.merchant.name}」的補登紀錄？" } }) { render IconComponent.new(name: :trash, size: 20) } if record.source_manual?) || "—"
    ] %>
  <% end %>
  <%= render DataTableComponent.new(headers: %w[日期 店家 人數 金額 來源 備註 操作], rows: rows, caption: "已訂購的紀錄", wrap_columns: [ 1, 5 ]) %>
<% else %>
  <%= render(EmptyStateComponent.new(title: "還沒有訂購紀錄")) do |empty| %>
    <% empty.with_action { link_to "去看看店家", merchants_path, class: "btn btn-primary" } %>
    在「已詢問」頁按打勾記錄訂購，或<%= link_to "補登過去訂過的店家", new_order_path, class: "font-medium underline" %>，就會記錄在這裡。
  <% end %>
<% end %>
